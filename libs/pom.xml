<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.fpetrola</groupId>
    <artifactId>libs</artifactId>
    <version>0.0.2-alu-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>libs</name>
    <!--
      Libraries, not plugins: what the plugins here use and other projects take from ~/.m2 by the
      same coordinates they always had (oozx-lift uses zx-rzx). No parent on purpose: the plugins'
      root makes every child depend on the framework, and whoever takes one of these would get it
      too. The emulator does not depend on any of them; a plugin that does carries them in its lib/
      (crystal.carry in the plugins' root), because the application no longer has them.
    -->
    <modules>
        <module>zx-rzx</module>
        <module>rzx</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite</artifactId>
                <version>1.11.4</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>18</source>
                    <target>18</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Xmx2g -Doozx.plugins=off</argLine>
                    <systemPropertyVariables>
                        <user.home>${project.build.directory}/home</user.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
