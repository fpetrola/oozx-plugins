<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.fpetrola.oozx</groupId>
        <artifactId>oozx-plugins</artifactId>
        <version>0.1.7</version>
    </parent>

    <artifactId>tools</artifactId>
    <packaging>pom</packaging>
    <name>tools</name>

    <!--
      A tool is a window over what a machine already has - its keys, its stick, what comes in the
      sound card - and not a board that answers ports. It arrives the same way a board does, by
      being found, and the desk cannot tell the difference: both are Equipment.
    -->
    <modules>
        <module>keyboard</module>
        <module>audio-in</module>
        <module>cassette</module>
        <module>dock</module>
        <module>catalogue</module>
        <module>controls</module>
        <module>games</module>
        <module>help</module>
        <module>rzx</module>
        <module>curvature</module>
        <module>calls</module>
        <module>heatmap</module>
        <module>io</module>
        <module>trace</module>
        <module>view</module>
        <module>looks</module>
        <module>memory-map</module>
        <module>frames</module>
        <module>pokes</module>
        <module>poke-finder</module>
        <module>map</module>
        <module>mappings</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>devices-kit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Like a board's jar: it says what it was built against, so what it needs can come with it. -->
    <build>
        <plugins>
            <plugin>
                <!-- A picture of everything each plugin offers, in its jar, for the catalogue to show at once: how each
                     machine starts, what ZXDB has of what it is, and its windows, or what it is when it has none. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>pictures-of-the-machines</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-Djava.awt.headless=true</argument>
                                <argument>-Doozx.plugins=off</argument>
                                <argument>-Duser.home=${project.build.directory}/pictures-home</argument>
                                <argument>-Doozx.build.cache=${user.home}/.cache/oozx-build</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.fpetrola.oozx.speccy.machine.PicturesOfTheMachines</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pictures-of-the-real-ones</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.fpetrola.oozx.api.PicturesOfTheRealOnes</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>draw-its-windows</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-Djava.awt.headless=true</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.fpetrola.oozx.speccy.tools.looks.DrawsTheWindows</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.github.fpetrola.oozx</groupId>
                        <artifactId>machine-pictures</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.github.fpetrola.oozx</groupId>
                        <artifactId>zxinfo</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.github.fpetrola.oozx</groupId>
                        <artifactId>tool-looks</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <!-- A window that builds a machine finds every device here, and they ask for what the desk carries. -->
                    <dependency>
                        <groupId>com.github.fpetrola.oozx</groupId>
                        <artifactId>app</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
