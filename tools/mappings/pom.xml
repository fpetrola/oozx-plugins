<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.fpetrola.oozx</groupId>
        <artifactId>tools</artifactId>
        <version>0.1.1</version>
    </parent>
    <artifactId>tool-mappings</artifactId>
    <packaging>jar</packaging>
    <name>tool-mappings</name>
    <!--
      How each thing goes into a file, said in the one place that knows both: the formats, and what
      is plugged in. The formats do not know the devices, and the devices never hear of a file.
    -->
    <dependencies>
        <!--
          The engine comes through device-snapshots and is never declared here: each plugin that
          declares it carries a copy in its own classloader, and the Mapping implemented here would
          then be another class than the one the formats ask for, and none would be found.
        -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-snapshots</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-ay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-ulaplus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>tool-pokes</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Each one only with its plugin: the mapping that names it is @OnlyWith it, and the rest go on without it. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-zxatasp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-divide</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-multiface</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-interface2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-simpleide</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-zxcf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-divmmc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-zxmmc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-covox</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-specdrum</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-uspeech</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-printer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-mouse</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-interface1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-disk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-scld</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-plusd</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-opus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-melodik</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-fuller</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-tape</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>tool-games</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The fixtures the formats are held to, and the machines they land on. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-snapshots</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-spectrum128</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-amstrad</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-timex</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- A Timex is a 48K underneath, and the 48K is the emulator's own. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-pentagon</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The real desk, for the test that keeps it and brings it back: no copy of it stands in. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>app</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- What loads the plugins, which the real desk needs to be built, and only the tests have: on what the plugin is
             compiled with it would bring PF4J's processor, which overwrites the index of the extensions. -->
        <dependency>
            <groupId>com.github.fpetrola.crystal-plugins</groupId>
            <artifactId>framework-guice</artifactId>
            <version>0.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-scorpion</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-spectrum-se</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-spectrum-variants</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The Beta 128 a 48K plugs in, beside the Pentagon's own. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-beta128</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-tapes</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-spec256</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <snapshots.corpus>${project.basedir}/../../devices/snapshots/src/test/resources/snapshots</snapshots.corpus>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
