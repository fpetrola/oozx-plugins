<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>devices</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>device-snapshots</artifactId>
    <packaging>jar</packaging>

    <name>The snapshot formats, read and written by walking the machine: Z80, SNA, SZX and SP</name>
    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>formats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>media-snapshot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- The 128K, the +2A and the +3, so that a snapshot of one lands on one. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-spectrum128</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-amstrad</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- libspectrum, which the readers here are held to, reached from the tests only: it is the
             oracle, not something a snapshot needs to be read. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- The harness of the fixtures, for the tests of what a file leaves in a machine once the
         mappings give the formats what is plugged in: those live with the mappings. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
