<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.fpetrola.oozx</groupId>
        <artifactId>devices</artifactId>
        <version>0.1.2</version>
    </parent>

    <artifactId>device-chloe</artifactId>
    <packaging>jar</packaging>

    <name>Chloe 140SE and 280SE</name>
    <dependencies>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-ay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-scld</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          The 280SE is built on the Spectrum SE, which arrives in its own jar: a plugin that
          needs another says so here, and the jar says it in its manifest, so taking this one
          brings that one too.
        -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-spectrum-se</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Two machines that have ULAplus soldered on, so they bring it with them. -->
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>device-ulaplus</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.fpetrola.oozx</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
